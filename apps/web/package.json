{
  "name": "@dajeong/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm check:env && next build --webpack",
    "build:turbopack": "pnpm check:env && next build",
    "check:env": "node ../../scripts/check-env.mjs --app web",
    "dev": "pnpm check:env && next dev",
    "lint": "eslint . --max-warnings=0",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@dajeong/api-client": "workspace:*",
    "@dajeong/design-tokens": "workspace:*",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@dajeong/config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
