          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "DELETED"
            ],
            "type": "string"
          }
        },
        "required": [
          "createdAt",
          "displayName",
          "id",
          "status"
        ],
        "type": "object"
      },
      "SystemHealthResponse": {
