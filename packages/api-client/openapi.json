{
  "components": {
    "schemas": {
      "ApiErrorResponse": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "CreateTripRequest": {
        "properties": {
          "endDate": {
            "example": "2026-08-23",
            "format": "date",
            "type": "string"
          },
          "startDate": {
            "example": "2026-08-21",
            "format": "date",
            "type": "string"
          },
          "title": {
            "example": "대전 여름 여행",
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "endDate",
          "startDate",
          "title"
        ],
        "type": "object"
      },
      "CurrentUserResponse": {
        "description": "현재 로그인한 내부 사용자",
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "DELETED"
            ],
            "type": "string"
          }
        },
        "required": [
          "createdAt",
          "displayName",
          "id",
          "status"
        ],
        "type": "object"
      },
      "InviteResponse": {
        "properties": {
          "code": {
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "code",
          "expiresAt"
        ],
        "type": "object"
      },
      "SystemHealthResponse": {
        "properties": {
          "database": {
            "enum": [
              "UP",
              "DOWN"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "UP",
              "DOWN"
            ],
            "type": "string"
          }
        },
        "required": [
          "database",
          "status"
        ],
        "type": "object"
      },
      "TripListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TripSummaryResponse"
            },
            "type": "array"
          },
          "nextCursor": {
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "TripSummaryResponse": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "endDate": {
            "format": "date",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "region": {
            "enum": [
              "DAEJEON"
            ],
            "type": "string"
          },
          "role": {
            "enum": [
              "HOST",
              "MEMBER"
            ],
            "type": "string"
          },
          "startDate": {
            "format": "date",
            "type": "string"
          },
          "status": {
            "enum": [
              "DRAFT",
              "ACTIVE",
              "COMPLETED",
              "ARCHIVED"
            ],
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "createdAt",
          "endDate",
          "id",
          "region",
          "role",
          "startDate",
          "status",
          "title"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/invites/{code}/join": {
      "post": {
        "operationId": "joinTripByInvite",
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripSummaryResponse"
                }
              }
            },
            "description": "이미 가입한 여행 반환"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripSummaryResponse"
                }
              }
            },
            "description": "새 MEMBER 멤버십 생성"
          },
          "401": {
            "description": "인증되지 않은 요청"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "여행 정원 초과"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "만료 또는 폐기된 초대"
          },
          "503": {
            "description": "여행 저장소 사용 불가"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "초대 코드로 여행 가입",
        "tags": [
          "invite-controller"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            },
            "description": "현재 사용자를 조회하거나 처음 생성함"
          },
          "401": {
            "description": "인증되지 않은 요청"
          },
          "503": {
            "description": "사용자 저장소를 사용할 수 없음"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "현재 사용자 조회",
        "tags": [
          "current-user-controller"
        ]
      }
    },
    "/api/v1/system/health": {
      "get": {
        "operationId": "getSystemHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemHealthResponse"
                }
              }
            },
            "description": "데이터베이스와 스키마가 준비됨"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemHealthResponse"
                }
              }
            },
            "description": "데이터베이스 또는 스키마를 사용할 수 없음"
          }
        },
        "summary": "시스템 상태 확인",
        "tags": [
          "system-health-controller"
        ]
      }
    },
    "/api/v1/trips": {
      "get": {
        "operationId": "listTrips",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "format": "int32",
              "maximum": 50,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripListResponse"
                }
              }
            },
            "description": "현재 사용자의 활성 여행 목록"
          },
          "400": {
            "description": "잘못된 cursor 또는 limit"
          },
          "401": {
            "description": "인증되지 않은 요청"
          },
          "503": {
            "description": "여행 저장소 사용 불가"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "내 여행 목록",
        "tags": [
          "trip-controller"
        ]
      },
      "post": {
        "operationId": "createTrip",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTripRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripSummaryResponse"
                }
              }
            },
            "description": "동일한 멱등 요청으로 생성된 여행 반환"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripSummaryResponse"
                }
              }
            },
            "description": "여행과 방장 멤버십 생성"
          },
          "400": {
            "description": "잘못된 생성 요청"
          },
          "401": {
            "description": "인증되지 않은 요청"
          },
          "409": {
            "description": "멱등 키 재사용 충돌"
          },
          "503": {
            "description": "여행 저장소 사용 불가"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "여행 생성",
        "tags": [
          "trip-controller"
        ]
      }
    },
    "/api/v1/trips/{tripId}/invites": {
      "post": {
        "operationId": "issueTripInvite",
        "parameters": [
          {
            "in": "path",
            "name": "tripId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteResponse"
                }
              }
            },
            "description": "새 7일 초대 코드 발급"
          },
          "401": {
            "description": "인증되지 않은 요청"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "방장 권한 없음"
          },
          "503": {
            "description": "여행 저장소 사용 불가"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "여행 초대 발급",
        "tags": [
          "invite-controller"
        ]
      }
    }
  }
}
