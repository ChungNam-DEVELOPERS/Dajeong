              "UP",
              "DOWN"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "UP",
              "DOWN"
            ],
            "type": "string"
          }
        },
        "required": [
          "database",
          "status"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "openapi": "3.1.0",
  "paths": {
